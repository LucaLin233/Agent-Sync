  "schemaVersion": 1,
  "note": "对象身份与落点的唯一活真源。present 仅表示受管存在性，不表示已部署或验收；写前按明确 ID 回读，冲突即停。不再自动互校或全量同名发现。",
  "contract": {
    "spec": "tools/body_contract.py",
    "implementation": "tools/body_contract.py",
    "body": "正文 = 去掉 YAML frontmatter 块及其后紧随的一个行终止符；不满足起止条件则整体为正文",
    "bytes": "原始字节读取；UTF-8 严格校验（含 frontmatter）；文本入口禁 BOM；CRLF 不归一；尾换行不规范化",
    "fields": "frontmatter 字段用 YAML 解析取值（缺字段/null/空串三分）；平台 JSON 字段解码后按值比较，不 trim",
    "resources": "包资源（references/scripts/assets 等）按原始字节复制与比较，不做正文规范化",
    "comparison": "文件载荷用全文；平台字段（soul.body / systemRole / skill content / persona prefix）用正文",
    "fieldTrailingNewline": {
      "measured": {
        "lh.skill.edit.content": "原样存储（写入 1695 B 正文 → 回读 1695 B）",
        "lh.agent.edit.systemRole": "原样存储（写入 3791 B 正文 → 回读 3791 B）",
        "minis.soul.body": "保留（写入 3790 B → 回读 3791 B：**强制补尾换行**，故仓库须带尾换行）",
        "minis.subagents.*.instructions": "**剥除**（写入带尾换行 → 回读无），故仓库三份子代理文件**不带**尾换行"
      },
      "boundedRule": "默认逐字节相等；确需新增形态例外须逐对象审定。只允许去掉恰好一个已登记尾 LF；禁止 rstrip 或无界规范化。"
    }
  },
