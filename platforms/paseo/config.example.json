{
  "version": 1,
  "daemon": {
    "mcp": {"enabled": true, "injectIntoAgents": true},
    "agentProfiles": [
      {"id": "luno-cchp", "name": "LUNO · CCHP", "provider": "cchp", "model": "gpt-6.2-sol", "modeId": "full-access", "thinkingOptionId": "high", "options": {"service_tier": "default", "paseo_role": "LUNO", "paseo_upstream": "cchp"}},
      {"id": "lens-cchp", "name": "LENS · CCHP", "provider": "cchp", "model": "gpt-6.2-sol", "modeId": "full-access", "thinkingOptionId": "high", "options": {"service_tier": "default", "paseo_role": "LENS", "paseo_upstream": "cchp"}},
      {"id": "forge-cchp", "name": "FORGE · CCHP", "provider": "cchp", "model": "deepseek-flash", "modeId": "full-access", "thinkingOptionId": "high", "options": {"paseo_role": "FORGE", "paseo_upstream": "cchp"}},
      {"id": "luno-gdr", "name": "LUNO · GDR", "provider": "gdr", "model": "gpt-6.2-sol", "modeId": "full-access", "thinkingOptionId": "high", "options": {"service_tier": "ultrafast", "paseo_role": "LUNO", "paseo_upstream": "gdr"}},
      {"id": "lens-gdr", "name": "LENS · GDR", "provider": "gdr", "model": "gpt-6.2-sol", "modeId": "full-access", "thinkingOptionId": "high", "options": {"service_tier": "ultrafast", "paseo_role": "LENS", "paseo_upstream": "gdr"}},
      {"id": "forge-gdr", "name": "FORGE · GDR", "provider": "gdr", "model": "gpt-6.2-sol", "modeId": "full-access", "thinkingOptionId": "high", "options": {"service_tier": "ultrafast", "paseo_role": "FORGE", "paseo_upstream": "gdr"}}
    ]
  },
  "agents": {
    "providers": {
      "cchp": {
        "extends": "codex", "label": "CCHP",
        "command": ["codex", "-c", "model_provider=\"cchp\""],
        "env": {
          "CODEX_HOME": "/home/example/codex-home",
          "PASEO_CODEX_ROLE_SOURCE": "/home/example/.luno/agent-sync/prompt/LUNO.md",
          "PASEO_CODEX_ROLE_MODEL_PROVIDER": "cchp",
          "PASEO_CODEX_ROLE_SHARED": "1",
          "PASEO_CODEX_ROLE_REQUIRED": "1"
        }
      },
      "gdr": {
        "extends": "codex", "label": "GDR",
        "command": ["codex", "-c", "model_provider=\"gdr\""],
        "env": {
          "CODEX_HOME": "/home/example/codex-home",
          "PASEO_CODEX_ROLE_SOURCE": "/home/example/.luno/agent-sync/prompt/LUNO.md",
          "PASEO_CODEX_ROLE_MODEL_PROVIDER": "gdr",
          "PASEO_CODEX_ROLE_SHARED": "1",
          "PASEO_CODEX_ROLE_REQUIRED": "1"
        }
      }
    }
  }
}
