{
  "$schema": "https://paseo.sh/schemas/paseo.config.v1.json",
  "version": 1,
  "daemon": {
    "mcp": {"enabled": true, "injectIntoAgents": true},
    "agentProfiles": [
      {
        "id": "cchp-luno",
        "name": "LUNO · CCHP",
        "provider": "codex-cchp",
        "model": "gpt-6.2-sol",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "default"},
        "systemPrompt": "受管会话角色：LUNO。"
      },
      {
        "id": "cchp-lens",
        "name": "LENS · CCHP",
        "provider": "codex-cchp",
        "model": "gpt-6.2-sol",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "default"},
        "systemPrompt": "受管会话角色：LENS。"
      },
      {
        "id": "cchp-forge",
        "name": "FORGE · CCHP",
        "provider": "codex-cchp",
        "model": "deepseek-flash",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "default"},
        "systemPrompt": "受管会话角色：FORGE。"
      },
      {
        "id": "cch-luno",
        "name": "LUNO · CCH",
        "provider": "codex-cch",
        "model": "gpt-6.2-sol",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "default"},
        "systemPrompt": "受管会话角色：LUNO。"
      },
      {
        "id": "cch-lens",
        "name": "LENS · CCH",
        "provider": "codex-cch",
        "model": "gpt-6.2-sol",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "default"},
        "systemPrompt": "受管会话角色：LENS。"
      },
      {
        "id": "cch-forge",
        "name": "FORGE · CCH",
        "provider": "codex-cch",
        "model": "deepseek-flash",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "default"},
        "systemPrompt": "受管会话角色：FORGE。"
      }
    ]
  },
  "agents": {
    "providers": {
      "codex-cchp": {
        "extends": "codex",
        "label": "Codex · CCHP",
        "command": ["/home/example/agent/runtime/bin/codex", "-c", "model_provider=\"cchp\""],
        "env": {
          "CODEX_HOME": "/home/example/agent/codex-home",
          "PATH": "/home/example/agent/runtime/bin:/usr/local/bin:/usr/bin:/bin"
        }
      },
      "claude-cchp": {
        "extends": "claude",
        "label": "Claude Code · CCHP",
        "env": {
          "CLAUDE_CONFIG_DIR": "/home/example/agent/claude-home",
          "ANTHROPIC_BASE_URL": "https://cchp.example.invalid"
        }
      },
      "codex-cch": {
        "extends": "codex",
        "label": "Codex · CCH",
        "command": ["/home/example/agent/runtime/bin/codex", "-c", "model_provider=\"cch\""],
        "env": {
          "CODEX_HOME": "/home/example/agent/codex-home",
          "PATH": "/home/example/agent/runtime/bin:/usr/local/bin:/usr/bin:/bin"
        }
      },
      "claude-cch": {
        "extends": "claude",
        "label": "Claude Code · CCH",
        "command": ["/home/example/agent/bin/claude-cch"],
        "env": {
          "CLAUDE_CONFIG_DIR": "/home/example/agent/claude-home",
          "ANTHROPIC_BASE_URL": "https://cch.example.invalid"
        }
      },
      "claude": {"enabled": false, "command": ["/home/example/agent/bin/claude-cchp"]},
      "codex": {"enabled": false},
      "copilot": {"enabled": false},
      "opencode": {"enabled": false},
      "pi": {"enabled": false},
      "omp": {"enabled": false}
    }
  }
}
