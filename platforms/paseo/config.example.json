{
  "$schema": "https://paseo.sh/schemas/paseo.config.v1.json",
  "version": 1,
  "daemon": {
    "mcp": {"enabled": true, "injectIntoAgents": true},
    "agentProfiles": [
      {
        "id": "cchp-luno",
        "name": "LUNO · CCHP",
        "provider": "codex-cchp",
        "model": "gpt-6.2-sol",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "default"}
      },
      {
        "id": "cchp-lens",
        "name": "LENS · CCHP",
        "provider": "codex-cchp",
        "model": "gpt-6.2-sol",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "default"}
      },
      {
        "id": "cchp-forge",
        "name": "FORGE · CCHP",
        "provider": "codex-cchp",
        "model": "deepseek-flash",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "default"}
      },
      {
        "id": "cch-luno",
        "name": "LUNO · CCH",
        "provider": "codex-cch",
        "model": "gpt-6.2-sol",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "default"}
      },
      {
        "id": "cch-lens",
        "name": "LENS · CCH",
        "provider": "codex-cch",
        "model": "gpt-6.2-sol",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "default"}
      },
      {
        "id": "cch-forge",
        "name": "FORGE · CCH",
        "provider": "codex-cch",
        "model": "deepseek-flash",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "default"}
      }
    ]
  },
  "agents": {
    "providers": {
      "codex-cchp": {
        "extends": "codex",
        "label": "Codex · CCHP",
        "command": ["codex", "-c", "model_provider=\"cchp\""],
        "env": {"CODEX_HOME": "/home/example/codex-home"}
      },
      "claude-cchp": {
        "extends": "claude",
        "label": "Claude Code · CCHP",
        "env": {
          "CLAUDE_CONFIG_DIR": "/home/example/claude-cchp",
          "ANTHROPIC_BASE_URL": "https://cchp.example.invalid"
        }
      },
      "codex-cch": {
        "extends": "codex",
        "label": "Codex · CCH",
        "command": ["codex", "-c", "model_provider=\"cch\""],
        "env": {"CODEX_HOME": "/home/example/codex-home"}
      },
      "claude-cch": {
        "extends": "claude",
        "label": "Claude Code · CCH",
        "env": {
          "CLAUDE_CONFIG_DIR": "/home/example/claude-cch",
          "ANTHROPIC_BASE_URL": "https://cch.example.invalid"
        }
      },
      "claude": {"enabled": false},
      "codex": {"enabled": false},
      "copilot": {"enabled": false},
      "opencode": {"enabled": false},
      "pi": {"enabled": false},
      "omp": {"enabled": false}
    }
  }
}
