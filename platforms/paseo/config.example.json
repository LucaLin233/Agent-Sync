{
  "$schema": "https://paseo.sh/schemas/paseo.config.v1.json",
  "version": 1,
  "daemon": {
    "mcp": {"enabled": true, "injectIntoAgents": true},
    "agentProfiles": [
      {
        "id": "cchp-luno",
        "name": "LUNO · CCHP",
        "provider": "cchp",
        "model": "gpt-6.2-sol",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "default"}
      },
      {
        "id": "cchp-lens",
        "name": "LENS · CCHP",
        "provider": "cchp",
        "model": "gpt-6.2-sol",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "default"}
      },
      {
        "id": "cchp-forge",
        "name": "FORGE · CCHP",
        "provider": "cchp",
        "model": "deepseek-flash",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "default"}
      },
      {
        "id": "gdr-luno",
        "name": "LUNO · GDR",
        "provider": "gdr",
        "model": "gpt-6.2-sol",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "ultrafast"}
      },
      {
        "id": "gdr-lens",
        "name": "LENS · GDR",
        "provider": "gdr",
        "model": "gpt-6.2-sol",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "ultrafast"}
      },
      {
        "id": "gdr-forge",
        "name": "FORGE · GDR",
        "provider": "gdr",
        "model": "gpt-6.2-sol",
        "modeId": "full-access",
        "thinkingOptionId": "high",
        "options": {"service_tier": "ultrafast"}
      }
    ]
  },
  "agents": {
    "providers": {
      "cchp": {
        "extends": "codex",
        "label": "CCHP",
        "command": ["codex", "-c", "model_provider=\"cchp\""],
        "env": {"CODEX_HOME": "/home/example/codex-home"}
      },
      "gdr": {
        "extends": "codex",
        "label": "GDR",
        "command": ["codex", "-c", "model_provider=\"gdr\""],
        "env": {"CODEX_HOME": "/home/example/codex-home"}
      },
      "claude": {"enabled": false},
      "codex": {"enabled": false},
      "copilot": {"enabled": false},
      "opencode": {"enabled": false},
      "pi": {"enabled": false},
      "omp": {"enabled": false}
    }
  }
}
